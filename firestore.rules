rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /partnerRequests/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
